# ============================================================================
# uv Specific Configuration
# ============================================================================
# Local virtual environments generated by uv
.venv/

# NOTE: Do NOT ignore 'uv.lock'. 
# It is highly recommended to commit uv.lock to version control for 
# consistent, reproducible builds across environments.
!uv.lock

# ============================================================================
# Python Core & Bytecode
# ============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so

# ============================================================================
# Distribution / Packaging / Build Artifacts
# ============================================================================
dist/
build/
eggs/
*.egg-info/
*.egg
.eggs/

# ============================================================================
# Environment Variables & Local Secrets (Security)
# ============================================================================
.env
.env.local
.env.*
!.env.example

# ============================================================================
# Testing, Coverage, & Code Quality (Ruff, Mypy, Pytest)
# ============================================================================
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ============================================================================
# IDEs and Editors (Optional)
# ============================================================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# ============================================================================
# 1st Energy — reverse-engineering artefacts (Security)
# ============================================================================
# HAR captures contain a plaintext password, live tokens, NMI, address and
# account number. These must never reach the repository.
*.har
*.har.gz
har/
captures/

# Unsanitised fixture output. dev/fixtures/ IS committed (sanitised test data),
# but anything marked raw stays local.
dev/fixtures/raw/
*.raw.json

# ============================================================================
# macOS SMB artefacts
# ============================================================================
# The projects share is mounted over SMB; macOS writes AppleDouble sidecars
# next to every file. They are not source.
._*
.AppleDouble
.Spotlight-V100
.Trashes
.smbdelete*
